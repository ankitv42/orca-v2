# LLM
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
GEMINI_MODEL=

# Storage: sqlite (local) | firestore (GCP, week 4+)
STORAGE_BACKEND=sqlite
SQLITE_PATH=data/orca.db

# GCP (week 4+, leave blank for now)
GCP_PROJECT_ID=
GCP_REGION=

# Observability
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=orca-v2

# Agent behaviour
AGENT_MAX_ITERATIONS=8
LOG_LEVEL=INFO